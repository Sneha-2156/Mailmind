# ============================================================
# MailMind AI — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.
# ============================================================

# ----------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------
APP_ENV=development                     # development | production
APP_SECRET_KEY=change-me-to-a-long-random-secret-key-32-chars-min
APP_NAME=MailMind AI
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ----------------------------------------------------------------
# DATABASE — PostgreSQL
# For local dev, use the values matching docker-compose.yml
# ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://mailmind:mailmind_secret@localhost:5432/mailmind_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mailmind_db
DATABASE_USER=mailmind
DATABASE_PASSWORD=mailmind_secret

# ----------------------------------------------------------------
# GOOGLE OAUTH 2.0
# Setup: https://console.cloud.google.com/apis/credentials
# 1. Create a project
# 2. Enable Gmail API
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
# ----------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# OAuth Scopes requested (do not change unless you understand Gmail API scopes)
# GOOGLE_SCOPES is internally set to:
#   openid email profile https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.modify

# ----------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------
# Used for Fernet encryption of OAuth tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# JWT settings
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Session cookie settings
SESSION_COOKIE_SECURE=false             # Set to true in production (HTTPS only)
SESSION_COOKIE_SAMESITE=lax

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------------------------------------------
# AI / LLM PROVIDER (Optional)
# Leave blank to disable AI features (summarization, extraction, smart replies)
# The app functions fully without this — AI features show a graceful fallback.
# ----------------------------------------------------------------
AI_PROVIDER=                            # gemini | openai | (blank = disabled)

# Google Gemini
GEMINI_API_KEY=
# Verify this against the currently available Gemini models
GEMINI_MODEL=gemini-2.0-flash
# Verify this against the currently available Gemini models
GEMINI_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------------
# ML CLASSIFIER
# ----------------------------------------------------------------
ML_MODEL_PATH=ml/artifacts/model_v1.pkl
ML_CONFIDENCE_THRESHOLD=0.45           # Below this → "Needs Review"

# ----------------------------------------------------------------
# GMAIL SYNC
# ----------------------------------------------------------------
GMAIL_MAX_EMAILS_PER_SYNC=50           # Emails fetched per sync operation
GMAIL_SYNC_HISTORY_DAYS=30             # How far back to sync on first connection

# ----------------------------------------------------------------
# FRONTEND
# Used by Vite — prefix all with VITE_ to expose to browser
# ----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=MailMind AI
VITE_APP_ENV=development

# ----------------------------------------------------------------
# PRODUCTION OVERRIDES (fill these when deploying)
# ----------------------------------------------------------------
# PRODUCTION_DOMAIN=yourdomain.com
# VITE_API_BASE_URL=https://api.yourdomain.com
# CORS_ORIGINS=https://yourdomain.com
# SESSION_COOKIE_SECURE=true
# APP_DEBUG=false

# Demo login is always on in development/test; set true to allow it elsewhere (e.g. a public portfolio demo)
ALLOW_DEMO_LOGIN=false

# Demo login is always on in development/test; set true to allow it elsewhere (e.g. a public portfolio demo)
ALLOW_DEMO_LOGIN=false
