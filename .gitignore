# ============================================================
# MailMind AI — .gitignore
# ============================================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Virtual environments
.venv/
venv/
ENV/
env/

# ----- Environment & Secrets -----
.env
.env.local
.env.production
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# ----- ML Artifacts -----
backend/ml/artifacts/*.pkl
backend/ml/artifacts/*.sav
backend/ml/artifacts/*.joblib
!backend/ml/artifacts/.gitkeep

# ----- Database -----
*.db
*.sqlite3
*.sqlite

# ----- Node / Frontend -----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ----- IDE -----
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ----- Testing -----
.pytest_cache/
.coverage
htmlcov/
*.cover
.nyc_output/
coverage/
test-results/
playwright-report/

# ----- Docker -----
docker-compose.override.yml

# ----- Alembic -----
# Keep migrations but not the compiled pyc
alembic/__pycache__/

# ----- Logs -----
logs/
*.log
backend/logs/

# ----- OS -----
.DS_Store
*.DS_Store
Thumbs.db
desktop.ini

# ----- Jupyter -----
.ipynb_checkpoints/
*.ipynb

# ----- Type checking cache -----
.mypy_cache/
.pyright/
